{
  "expo": {
    "name": "XonTaom",
    "slug": "xontaom",
    "version": "1.7.9",
    "icon": "./assets/xontaom-app-icon.png",
    "orientation": "portrait",
    "scheme": "xontaom",
    "userInterfaceStyle": "automatic",
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "uz.xontaom.app",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      }
    },
    "android": {
      "package": "uz.xontaom.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/xontaom-app-icon.png",
        "backgroundColor": "#B6000C"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "XonTaom restoran menyusiga taom rasmini qo‘shish uchun galereyaga kirish ruxsatini so‘raydi.",
          "cameraPermission": false
        }
      ],
      "expo-font",
      "expo-asset",
      "expo-web-browser",
      [
        "react-native-nitro-google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.566559516343-6e257k55sulka40je39qugfl6oavenab"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
